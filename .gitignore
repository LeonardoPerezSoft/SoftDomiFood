# Proyecto SoftDomiFood - reglas compartidas

# Dependencias
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Variables de entorno
.env
.env.local
.env.*.local

# Builds
/dist/
/build/
*.tsbuildinfo

# IDE/editor (compartido)
.vscode/
.idea/
*.swp
*.swo
*~

# Artefactos antiguos
frontend_OLD/

# SO
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# DB archivos
*.db
*.sqlite

# Backups (excepto inicial)
database/backups/backup_*.sql
!database/backups/initial_data.sql

# Docker
.dockerignore

# Cobertura
.coverage
coverage.xml
htmlcov/

# Python virtual env y caches
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pylint.d/
*.egg-info/
.eggs/

# Herramientas JS/TS adicionales
.eslintcache
.pnpm-store/

# Caches de bundlers
.parcel-cache/
.vite/
.turbo/

# Reportes temporales QA (se pueden regenerar)
qa_automated/RESULTADOS_ANALISIS_SEGURIDAD.md
qa_automated/RESULTADOS_EJECUCION.md
qa_automated/generate_reports.html

# Capturas locales y archivos sueltos (opcional ignorar)
ChatGPT Image *.png

# Prisma artefactos (si se generan)
worker/prisma/migrations/

# Archivo de bloqueo de intérprete Python (pyenv, etc.)
.python-version


